# =============================================================================
# Hameed Latif Lab - Environment Configuration Template
# =============================================================================
# DO NOT put real secrets or API keys in this file.
# Copy this file to .env or set environment variables in your hosting provider.

# Google Gemini API Key (Server-side only)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_google_api_key_here

# ASP.NET Core Environment (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development

# Backend Hosting Port
ASPNETCORE_URLS=http://localhost:5153
