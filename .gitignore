# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# -----------------------------------------------------------------------------
# Environment variables and secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
**/.env
**/.env.*
!**/.env.example
!**/.env.template

# Local environment configuration (Angular)
environment.local.ts
environment.*.local.ts
**/environment.local.ts
**/environment.*.local.ts

# Backend configuration secrets (.NET)
appsettings.Development.json
appsettings.Production.json
appsettings.*.local.json
**/appsettings.Development.json
**/appsettings.Production.json
**/appsettings.*.local.json

# -----------------------------------------------------------------------------
# Frontend - Dependencies and Build Outputs (Angular)
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
.angular/
**/.angular/
tmp/
out-tsc/
bazel-out/
.sass-cache/

# -----------------------------------------------------------------------------
# Backend - Build Outputs and User Caches (.NET)
# -----------------------------------------------------------------------------
**/bin/
**/obj/
.vs/
**/.vs/
*.user
*.userosscache
*.suo
*.userprefs

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
yarn-error.log*
testem.log
/libpeerconnection.log

# -----------------------------------------------------------------------------
# Local Editor and Operating System Files
# -----------------------------------------------------------------------------
.idea/
**/.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
/connect.lock
/coverage
/typings
__screenshots__/
